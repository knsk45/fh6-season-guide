[Unit]
Description=FH6 one-use owner password broker
Before=fh6-phone.service
[Service]
User=root
Group=fh6
ExecStart=/usr/bin/python3 /usr/local/lib/fh6/phone_password.py serve
Restart=on-failure
RuntimeDirectory=fh6-phone
RuntimeDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/etc/fh6 /run/fh6-phone
UMask=0077
[Install]
WantedBy=multi-user.target
