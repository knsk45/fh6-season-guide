[Unit]
Description=FH6 owner-requested unscheduled audit
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/fh6/repo
ExecStart=/usr/bin/python3 /opt/fh6/repo/automation/server/runner.py run --force
Environment=FH6_BROWSER_QA=/opt/fh6/venv/bin/python
TimeoutStartSec=3600
UMask=0027
Nice=10
