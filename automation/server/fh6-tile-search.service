[Unit]
Description=FH6 opt-in exact tile research using the existing publisher
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/fh6/repo
ExecStart=/usr/bin/python3 /opt/fh6/repo/automation/server/tile_search.py
TimeoutStartSec=3600
UMask=0027
Nice=10
Environment=FH6_BROWSER_QA=/opt/fh6/venv/bin/python
