[Unit]
Description=FH6 editorial audit and guarded publication
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/fh6/repo/automation/server/runner.py run
WorkingDirectory=/opt/fh6/repo
TimeoutStartSec=3600
UMask=0027
Nice=10
Environment=FH6_BROWSER_QA=/opt/fh6/venv/bin/python
