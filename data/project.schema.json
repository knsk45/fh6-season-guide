{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FH6 project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "branding", "support"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faviconPng", "appleTouchIcon", "themeColor"],
      "properties": {
        "faviconPng": { "type": "string", "pattern": "^reports/assets/project/[^/]+\\.png$" },
        "appleTouchIcon": { "type": "string", "pattern": "^reports/assets/project/[^/]+\\.png$" },
        "themeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "title", "description", "url", "buttonLabel", "qrAsset", "buttonAsset"],
      "properties": {
        "enabled": { "const": true },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://www\\.sberbank\\.com/" },
        "buttonLabel": { "type": "string", "minLength": 1 },
        "qrAsset": { "type": "string", "pattern": "^reports/assets/project/[^/]+\\.png$" },
        "buttonAsset": { "type": "string", "pattern": "^reports/assets/project/[^/]+\\.svg$" }
      }
    }
  }
}
